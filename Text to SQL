graph TD
    subgraph User Interaction
        A[User] --> B(Natural Language Question);
    end

    subgraph Application Layer (Python Script)
        B --> C{Application Gateway};
        C --> D[Load Knowledge Base (schema.json, mappings.json)];

        D --> E[Craft LLM Prompt];
        E -- (Includes User Question + Schema + Mappings + Instructions) --> F[Call LLM API];

        F -- Generated SQL Query --> G[Receive LLM Response];
        G{Is SQL Valid and executable?};
        G -- Yes (SELECT/SHOW) --> H[Execute SQL Query on Database];
        G -- No / Error / Not SELECT --> I[Handle Error / Inform User / Do not execute];

        H -- Query Results --> J[Format Results];
        J --> K[Display Results to User];
        I --> K;
    end

    subgraph LLM Layer
        F -- API Request --> L[Large Language Model (e.g., Gemini, GPT)];
        L -- Processes Prompt --> M[SQL Generation Logic];
        M -- Generated SQL --> F;
    end

    subgraph Database Layer
        N[In-memory SQLite DB]
        D --> N;
        H --> N;
        N -- Sample Data / Schema Creation --> H;
    end

    K --> B;

