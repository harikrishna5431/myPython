# 1. Load Knowledge Base
def load_knowledge_base():
    with open('schema.json', 'r') as f:
        schema_data = json.load(f)
    with open('mappings.json', 'r') as f:
        mappings_data = json.load(f)
    return schema_data, mappings_data

schema, mappings = load_knowledge_base()

# Create a simple in-memory SQLite database for PoC
def setup_database(schema_data):
    conn = sqlite3.connect(':memory:') # In-memory database
    cursor = conn.cursor()

    for db in schema_data['database_name']: # Assuming database_name is a list of DBs
        for table in db['tables']: # Or schema_data['tables'] directly if no nested 'database_name'
            columns_sql = []
            for col in table['columns']:
                columns_sql.append(f"{col['column_name']} {col['data_type']}")
            create_table_sql = f"CREATE TABLE IF NOT EXISTS {table['table_name']} ({', '.join(columns_sql)});"
            cursor.execute(create_table_sql)
            # You can add some sample data here as well for testing
    conn.commit()
    return conn

db_conn = setup_database(schema) # Pass the correct schema data structure

def get_sql_from_llm(user_question, schema_data, mappings_data):
    # Craft the prompt (customize based on your chosen LLM and its best practices)
    prompt = f"""
    You are a database expert. Your task is to convert natural language questions into SQL queries.
    Adhere strictly to the provided schema and business descriptions. Do not invent tables or columns.

    Here is the database schema:
    {json.dumps(schema_data, indent=2)}

    Here are some data transformation rules and mappings (use if relevant to the question):
    {json.dumps(mappings_data, indent=2)}

    User Question: {user_question}

    Generate only the SQL query. If you cannot answer the question with the provided information, respond with 'I cannot answer this question with the available information.'.

    SQL:
    """

    try:
        # For OpenAI
        # response = client.chat.completions.create(
        #     model="gpt-3.5-turbo", # or "gpt-4"
        #     messages=[
        #         {"role": "system", "content": "You are a helpful assistant that generates SQL queries."},
